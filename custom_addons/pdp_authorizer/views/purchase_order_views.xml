<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_pdp_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.pdp.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="pdp_status" widget="badge"
                       decoration-success="pdp_status == 'allow'"
                       decoration-warning="pdp_status == 'require_approval'"
                       decoration-danger="pdp_status == 'deny'"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="PDP Authorization" name="pdp_authorization">
                    <group>
                        <group>
                            <field name="pdp_department"
                                   readonly="state in ('purchase', 'done', 'cancel')"/>
                            <field name="ai_agent_id"
                                   readonly="state in ('purchase', 'done', 'cancel')"/>
                            <field name="delegated_by_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="delegation_grant_id"
                                   domain="[('state', '=', 'active')]"
                                   readonly="state in ('purchase', 'done', 'cancel')"/>
                            <field name="pdp_delegation_nonce" readonly="1"
                                   groups="base.group_system"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
