<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pdp_delegation_grant_form" model="ir.ui.view">
        <field name="name">pdp.delegation.grant.form</field>
        <field name="model">pdp.delegation.grant</field>
        <field name="arch" type="xml">
            <form string="AI Agent Delegation Grant">
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_revoke" string="Revoke" type="object"
                            class="btn-danger" invisible="state != 'active'"
                            confirm="Revoke this delegation in the PDP?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,revoked,expired"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="agent_id" readonly="state != 'draft'"/>
                            <field name="max_amount" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="valid_from" readonly="state != 'draft'"/>
                            <field name="valid_until" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pdp_delegation_grant_tree" model="ir.ui.view">
        <field name="name">pdp.delegation.grant.tree</field>
        <field name="model">pdp.delegation.grant</field>
        <field name="arch" type="xml">
            <tree string="AI Agent Delegation Grants">
                <field name="name"/>
                <field name="user_id"/>
                <field name="agent_id"/>
                <field name="max_amount"/>
                <field name="valid_until"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="action_pdp_delegation_grant" model="ir.actions.act_window">
        <field name="name">AI Agent Delegations</field>
        <field name="res_model">pdp.delegation.grant</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_pdp_delegation_grant" name="AI Agent Delegations"
              parent="purchase.menu_purchase_root"
              action="action_pdp_delegation_grant" sequence="80"
              groups="purchase.group_purchase_user"/>
</odoo>
